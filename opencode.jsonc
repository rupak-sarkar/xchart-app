{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "fabric": {
      "name": "FastAPI Fabric Proxy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:4001/v1",
        "apiKey": "none"
      },
      "models": {
        "gpt-5.1": {
          "name": "Fabric gpt-5.1",
          "attachment": true,
          "reasoning": false,
          "temperature": false,
          "tool_call": true,
          "limit": {
            "context": 400000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    },
    "gemini-enterprise": {
      "name": "FastAPI Gemini Enterprise Proxy",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "none"
      },
      "models": {
        "argon-4": {
          "name": "Gemini Enterprise Argon-4",
          "attachment": false,
          "reasoning": false,
          "temperature": false,
          "tool_call": true,
          "limit": {
            "context": 120000,
            "output": 128000
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  },
  "permission": {},
  "default_agent": "openwork",
  "agent": {
    "openwork": {
      "model": "fabric/gpt-5.1",
      "description": "OpenWork default agent using Fabric gpt-5.1",
      "mode": "primary",
      "permission": {
        "skill": {
          "customize-opencode": "deny",
          "get-started": "deny",
          "command-creator": "deny",
          "agent-creator": "deny",
          "plugin-creator": "deny"
        }
      }
    },
    "openwork-gemini": {
      "model": "gemini-enterprise/argon-4",
      "description": "OpenWork agent using Gemini Enterprise Argon-4",
      "mode": "primary",
      "permission": {
        "skill": {
          "customize-opencode": "deny",
          "get-started": "deny",
          "command-creator": "deny",
          "agent-creator": "deny",
          "plugin-creator": "deny"
        }
      }
    }
  }
}
 
